---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery';

// Add photos here. src paths are relative to /public.
const photos = [
  { id: 1, src: '/images/photography/photo1.jpg', title: '', year: 2009, theme: 'Street' },
];
---

<Layout title="Photography" activePage="/photography">
  <header class="page-head">
    <span class="label">Photography · since 2008</span>
    <h1>Photography</h1>
    <p class="deck">Street, urban and portrait work. The same attention to composition and light runs through my design and data visualisation.</p>
  </header>
  <PhotoGallery photos={photos} client:load />
</Layout>
