---
import Layout from '../layouts/Layout.astro';
import resumeData from '../data/resume.json';

const info     = resumeData.personalInfo;
const networks = resumeData.socialNetworks ?? [];

const rows = [
  info.email    ? { label: 'Email',    href: `mailto:${info.email}`,  text: info.email    } : null,
  info.phone    ? { label: 'Phone',    href: null,                     text: info.phone    } : null,
  info.location ? { label: 'Location', href: null,                     text: info.location } : null,
  ...networks.map(n => {
    const url = (n as any).url ?? (n as any).link ?? '';
    return { label: n.name, href: url, text: url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') };
  }),
].filter(Boolean) as Array<{ label: string; href: string | null; text: string }>;
---

<Layout title="Contact" activePage="/contact">
  <header class="page-head">
    <span class="label">Contact</span>
    <h1>Let's talk</h1>
    <p class="deck">About product leadership, design, data visualisation or an advisory mandate. Email is the fastest way to reach me.</p>
  </header>
  <div class="contact-body">
    <ul class="contact-list">
      {rows.map(r => (
        <li>
          <span class="label">{r.label}</span>
          {r.href
            ? <a class="value" href={r.href} target={r.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer">{r.text}</a>
            : <span class="value">{r.text}</span>}
        </li>
      ))}
    </ul>
  </div>
</Layout>
