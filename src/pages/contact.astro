---
import Layout from '../layouts/Layout.astro';
import resumeData from '../data/resume.json';

// ultra simple: email first, then the two profiles worth visiting
// (phone, location and 500px stay in resume.json but are not shown)
const info     = resumeData.personalInfo;
const networks = resumeData.socialNetworks ?? [];
const profile  = (name: string) => {
  const n = networks.find(n => n.name === name) as { link?: string; url?: string } | undefined;
  return n?.link ?? n?.url ?? '';
};
const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const rows = [
  { label: 'email',      href: `mailto:${info.email}`,  text: info.email },
  { label: 'linkedin',   href: profile('LinkedIn'),     text: short(profile('LinkedIn')) },
  { label: 'observable', href: profile('ObservableHQ'), text: short(profile('ObservableHQ')) },
  { label: 'instagram',  href: profile('Instagram'),    text: short(profile('Instagram')) },
  { label: '500px',      href: profile('500px'),        text: short(profile('500px')) },
  // the photography site will live at /photography on this domain
  { label: 'photography', href: '/photography',         text: 'ig2gi.github.io/photography' },
].filter(r => r.href && r.text);
---

<Layout title="Contact" activePage="/contact">
  <!-- the selected nav link already names the page -->
  <h1 class="sr-only">Contact</h1>
  <p class="page-intro">Email is the fastest way to reach me.</p>
  <ul class="contact-list">
    {rows.map(r => (
      <li>
        <span class="label">{r.label}</span>
        <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{r.text}</a>
      </li>
    ))}
  </ul>
</Layout>
