---
import Layout from '../layouts/Layout.astro';
import CareerRibbon from '../components/CareerRibbon.astro';
import ProfileSections from '../components/ProfileSection';
import profile from '../data/profile.json';

const { hero, ribbon, principles, close } = profile;

// labels are uppercased by CSS; SOPHiA keeps its lowercase i
const keepCase = (s: string) => s.replaceAll('SOPHiA', 'SOPH<span class="keep-case">i</span>A');
---

<Layout title="Gilbert Perrin" activePage="/">
  <section class="hero">
    <h1 set:html={hero.title} />
    <p class="deck">{hero.deck}</p>
    <div class="byline label">
      {hero.byline.map(b => <span set:html={keepCase(b)} />)}
    </div>
  </section>

  <CareerRibbon title={ribbon.title} caption={ribbon.caption} notes={ribbon.notes} domains={ribbon.domains} />

  <section class="principles" aria-label="How I work">
    {principles.map(p => (
      <div class="principle">
        <span class="label">{p.when}</span>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
      </div>
    ))}
  </section>

  <ProfileSections data={profile} />

  <section class="close">
    <h2 set:html={close.title} />
    <div class="ctas">
      <a class="btn btn-primary" href={close.cta.url}>{close.cta.label} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
