---
import Layout from '../layouts/Layout.astro';
import CareerRibbon from '../components/CareerRibbon.astro';
import ProfileSections from '../components/ProfileSection';
import profile from '../data/profile.json';

const { hero, ribbon, headings, principles, close } = profile;

// labels are uppercased by CSS; SOPHiA keeps its lowercase i
const keepCase = (s: string) => s.replaceAll('SOPHiA', 'SOPH<span class="keep-case">i</span>A');
---

<Layout title="Gilbert Perrin" activePage="/">
  <section class="hero">
    <h1 set:html={hero.title} />
    <p class="deck">{hero.deck}</p>
    <div class="byline label">
      {hero.byline.map(b => <span set:html={keepCase(b)} />)}
    </div>
  </section>

  <CareerRibbon title={ribbon.title} caption={ribbon.caption} notes={ribbon.notes} domains={ribbon.domains} />

  <section class="principles block-band" aria-labelledby="principles-title">
    <h2 id="principles-title" class="section-title" set:html={headings.principles} />
    {principles.map((p, i) => (
      <div class={`principle${p.when === 'Always' ? ' principle-always' : ''}`}>
        <div class="principle-when">
          <span class="label">{p.when}</span>
          {principles[i + 1]?.when === 'Then' && <span class="principle-next" aria-hidden="true"></span>}
        </div>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
      </div>
    ))}
  </section>

  <section class="profile" aria-labelledby="profile-title">
    <h2 id="profile-title" class="section-title" set:html={headings.sections} />
    <ProfileSections data={profile} />
  </section>

  <section class="close block-band">
    <h2 set:html={close.title} />
    <div class="ctas">
      <a class="btn btn-primary" href={close.cta.url}>{close.cta.label} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
