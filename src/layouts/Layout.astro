---
import '../styles/main.css';
import resumeData from '../data/resume.json';

interface Props {
  title?: string;
  activePage?: string;
  description?: string;
}

const {
  title = 'Gilbert Perrin',
  activePage = '',
  description = 'Gilbert Perrin — Product, Design & Engineering leader',
} = Astro.props;

const navPages = [
  { name: 'Timeline',           path: '/timeline' },
  { name: 'Resume',             path: '/resume' },
  { name: 'Data visualisation', path: '/dataviz' },
  { name: 'Photography',        path: '/photography' },
  { name: 'Contact',            path: '/contact' },
];

const socials = (resumeData.socialNetworks ?? []) as Array<{ name: string; link?: string; url?: string }>;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === 'Gilbert Perrin' ? title : `${title} · Gilbert Perrin`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="masthead">
        <div class="masthead-inner">
          <div class="brand">
            <a class="wordmark" href="/">Gilbert <em>Perrin</em></a>
            <div class="pillars" aria-label="Product, design and engineering, with AI as a companion">
              <span>Product</span><span class="dot">·</span><span>Design</span><span class="dot">·</span><span>Engineering</span><span class="plus">+</span><span class="ai">AI</span>
            </div>
          </div>
          <nav class="site-nav" aria-label="Main">
            {navPages.map(p => (
              <a href={p.path} aria-current={activePage === p.path ? 'page' : undefined}>{p.name}</a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="colophon label">
        <span>© {year} Gilbert Perrin · Lausanne, Switzerland</span>
        <nav aria-label="Elsewhere">
          {socials.map(s => (
            <a href={s.link ?? s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
          ))}
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
