---
import '../styles/main.css';
import resumeData from '../data/resume.json';

interface Props {
  title?: string;
  activePage?: string;
  description?: string;
}

const {
  title = 'Gilbert Perrin',
  activePage = '',
  description = 'Gilbert Perrin — Product, Design & Engineering leader',
} = Astro.props;

// Home comes first: the wordmark alone was not an obvious way back
const navPages = [
  { name: 'home',        path: '/' },
  { name: 'track record', path: '/track-record' },
  { name: 'dataviz',     path: '/dataviz' },
  { name: 'photography', path: '/photographer' },
  { name: 'resume',      path: '/resume' },
  { name: 'contact',     path: '/contact' },
];

// footer: the same profiles as the contact page, in lowercase like the header
const networks = (resumeData.socialNetworks ?? []) as Array<{ name: string; link?: string; url?: string }>;
const socials = [
  ['LinkedIn', 'linkedin'], ['ObservableHQ', 'observable'], ['Instagram', 'instagram'], ['500px', '500px'],
].map(([name, label]) => {
  const n = networks.find(n => n.name === name);
  return { label, href: n?.link ?? n?.url ?? '' };
}).filter(s => s.href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === 'Gilbert Perrin' ? title : `${title} · Gilbert Perrin`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="masthead">
        <div class="masthead-inner">
          <div class="brand">
            <a class="wordmark" href="/">Gilbert <em>Perrin</em></a>
            <div class="pillars" aria-label="Product, design and engineering, with AI as a companion">
              <span>Product</span><span class="dot">·</span><span>Design</span><span class="dot">·</span><span>Engineering</span><span class="plus">+</span><span class="ai">AI</span>
            </div>
          </div>
          <!-- small screens: the links fold into a burger menu; <details> opens and closes without JavaScript -->
          <details class="nav-toggle">
            <summary aria-label="Menu"><span class="burger" aria-hidden="true"></span></summary>
          </details>
          <nav class="site-nav" aria-label="Main">
            {navPages.map(p => (
              <a href={p.path} aria-current={activePage === p.path ? 'page' : undefined}>{p.name}</a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="colophon label">
        <span>© {year} Gilbert Perrin · Lausanne, Switzerland</span>
        <nav aria-label="Elsewhere">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
          <a href="/contact">contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
