---
// Header gear: a small dropdown to switch the colour theme live.
// <details> opens and closes without JavaScript; the script applies and remembers the choice.
import { THEMES, THEME_KEY } from '../lib/theme';
---
<details class="theme-menu">
  <summary aria-label="Colour theme" title="Colour theme">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
  </summary>
  <div class="theme-menu-panel" data-key={THEME_KEY}>
    <span class="label">Theme</span>
    {THEMES.map(t => (
      <button type="button" data-theme-id={t.id} aria-pressed="false">
        <!-- the swatch carries its own data-theme, so it shows that palette whatever the page uses -->
        <span class="theme-swatch" data-theme={t.id} aria-hidden="true"><i></i><i></i><i></i></span>
        {t.label}
      </button>
    ))}
  </div>
</details>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.theme-menu');
  if (menu) {
    const root = document.documentElement;
    const key = menu.querySelector<HTMLElement>('.theme-menu-panel')!.dataset.key!;
    const buttons = [...menu.querySelectorAll<HTMLButtonElement>('[data-theme-id]')];
    const mark = () => buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.themeId === root.dataset.theme)));
    mark();

    buttons.forEach(b => b.addEventListener('click', () => {
      root.dataset.theme = b.dataset.themeId!;
      try { localStorage.setItem(key, b.dataset.themeId!); } catch {}
      mark();
      menu.open = false;
    }));

    // one header menu open at a time; close on Escape or a click elsewhere
    const burger = document.querySelector<HTMLDetailsElement>('.nav-toggle');
    menu.addEventListener('toggle', () => { if (menu.open && burger) burger.open = false; });
    burger?.addEventListener('toggle', () => { if (burger.open) menu.open = false; });
    document.addEventListener('click', e => { if (!menu.contains(e.target as Node)) menu.open = false; });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')!.focus(); }
    });
  }
</script>
