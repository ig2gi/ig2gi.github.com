---
// Normalising inputs, in three steps on the same 2-feature training set: raw, centred
// (minus μ), scaled (divided by σ). Same axes in all three panels so the shift and the
// shrink are visible. Points come from a seeded generator: the same drawing on every build.
import katex from 'katex';

const N = 80;

// mulberry32 + Box–Muller: deterministic normal samples
function rng(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(7);
const normal = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());

const raw = Array.from({ length: N }, () => [5 + 2.4 * normal(), 3.5 + 0.7 * normal()]);
const mean = [0, 1].map(k => raw.reduce((s, p) => s + p[k], 0) / N);
const sd = [0, 1].map(k => Math.sqrt(raw.reduce((s, p) => s + (p[k] - mean[k]) ** 2, 0) / N));
const centred = raw.map(p => p.map((v, k) => v - mean[k]));
const scaled = centred.map(p => p.map((v, k) => v / sd[k]));

const D: [number, number] = [-7, 13];
const S = 200;
const sx = (v: number) => ((v - D[0]) / (D[1] - D[0])) * S;
const sy = (v: number) => S - sx(v);

const panels = [
  { name: 'Raw', tex: 'x', pts: raw },
  { name: 'Centred', tex: 'x - \\mu', pts: centred },
  { name: 'Scaled', tex: '(x - \\mu)\\, /\\, \\sigma', pts: scaled },
];

const tex = (s: string) => katex.renderToString(s, { throwOnError: true });
---

<figure class="note-norm">
  <div class="note-norm-grid">
    {panels.map((p, i) => (
      <div class="note-norm-cell">
        <svg viewBox={`0 0 ${S} ${S}`} role="img" aria-label={`${p.name} training set, two features`}>
          <line class="note-norm-axis" x1="0" x2={S} y1={sy(0)} y2={sy(0)} />
          <line class="note-norm-axis" x1={sx(0)} x2={sx(0)} y1="0" y2={S} />
          {p.pts.map(([a, b]) => <circle class="note-norm-pt" cx={sx(a)} cy={sy(b)} r="2.6" />)}
        </svg>
        <div class="note-norm-caption">
          <span class="label">{String(i + 1).padStart(2, '0')} · {p.name}</span>
          <span set:html={tex(p.tex)} />
        </div>
      </div>
    ))}
  </div>
  <figcaption class="ps-caption">Two input features x₁ and x₂ on the same axes. Centring moves the cloud to 0, scaling gives both features the same spread.</figcaption>
</figure>
