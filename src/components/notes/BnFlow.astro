---
// Inside one layer with batch normalisation: from a[l−1] to a[l], the BN step in the middle.
// Horizontal on wide screens, vertical on a phone.
import katex from 'katex';
const tex = (s: string) => katex.renderToString(s, { throwOnError: true });

const steps = [
  { label: 'Linear', tex: 'z^{[l]} = W^{[l]} a^{[l-1]}' },
  { label: 'Normalise', tex: 'z^{[l]}_{norm} = \\dfrac{z^{[l]} - \\mu}{\\sqrt{\\sigma^2 + \\epsilon}}', bn: true },
  { label: 'Scale and shift', tex: '\\tilde z^{[l]} = \\gamma^{[l]} z^{[l]}_{norm} + \\beta^{[l]}', bn: true },
  { label: 'Activation', tex: 'a^{[l]} = g^{[l]}\\big(\\tilde z^{[l]}\\big)' },
];
---

<figure class="note-bn">
  <div class="note-bn-flow">
    <span class="note-bn-end" set:html={tex('a^{[l-1]}')} />
    <span class="note-bn-arrow" aria-hidden="true"></span>
    <div class="note-bn-layer">
      <span class="note-bn-layer-label">One hidden layer</span>
      <div class="note-bn-steps">
        <div class="note-bn-step">
          <span class="note-bn-step-label">{steps[0].label}</span>
          <span set:html={tex(steps[0].tex)} />
        </div>
        <div class="note-bn-box">
          <span class="note-bn-box-label">Batch norm</span>
          {steps.slice(1, 3).map(s => (
            <div class="note-bn-step">
              <span class="note-bn-step-label">{s.label}</span>
              <span set:html={tex(s.tex)} />
            </div>
          ))}
        </div>
        <div class="note-bn-step">
          <span class="note-bn-step-label">{steps[3].label}</span>
          <span set:html={tex(steps[3].tex)} />
        </div>
      </div>
    </div>
    <span class="note-bn-arrow" aria-hidden="true"></span>
    <span class="note-bn-end" set:html={tex('a^{[l]}')} />
  </div>
</figure>
